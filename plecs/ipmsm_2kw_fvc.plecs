        Prompt        base64 "SjogVG90YWwgaW5lcnRpYSAoa2dtwrIp"
        Type          FreeText
        Value         "0.015"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_alpha_s"
        Prompt        "alpha_s: Reference-tracking bandwidth (rad/s)"
        Type          FreeText
        Value         "25.0"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_alpha_i"
        Prompt        "alpha_i: Integral-action bandwidth (rad/s), [] = alpha_"
"s"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_tau_M_max"
        Prompt        "tau_M_max: Maximum motor torque (Nm)"
        Type          FreeText
        Value         "inf"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Terminal {
