          Direction     right
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "Index"
            Value         "7"
            Show          on
          }
          Parameter {
            Variable      "Width"
            Value         "-1"
            Show          off
          }
        }
        Component {
          Type          Output
          Name          "misc"
          Show          on
          Position      [340, 160]
          Direction     right
          Flipped       off
          LabelPosition south
          Parameter {
            Variable      "Index"
            Value         "8"
            Show          on
          }
          Parameter {
            Variable      "Width"
            Value         "-1"
            Show          off
          }
        }
        Connection {
          Type          Signal
          SrcComponent  "i_s_abc"
          SrcTerminal   1
          Points        [120, 60; 120, 80]
          DstComponent  "C-Script"
          DstTerminal   1
        }
        Connection {
          Type          Signal
          SrcComponent  "u_dc"
          SrcTerminal   1
          DstComponent  "C-Script"
          DstTerminal   2
        }
        Connection {
          Type          Signal
          SrcComponent  "w_M_ref"
          SrcTerminal   1
          Points        [120, 120; 120, 100]
          DstComponent  "C-Script"
          DstTerminal   3
