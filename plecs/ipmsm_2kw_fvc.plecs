        Variable      "Before"
        Value         "0.0"
        Show          off
      }
      Parameter {
        Variable      "After"
        Value         "50.0"
        Show          off
      }
      Parameter {
        Variable      "DataType"
        Value         "10"
        Show          off
      }
    }
    Component {
      Type          Subsystem
      Name          "Control system"
      Show          on
      Position      [300, 200]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -60; 50, 60]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Sensorless flux-vector control (motulator)"
      MaskDescription "Speed control of a synchronous machine drive with senso"
"rless flux-vector control. The parameters correspond to the motulator API: Sy"
"nchronousMachinePars, FluxVectorControllerCfg, and SpeedController. Empty par"
"ameters ([]) correspond to None, i.e., the defaults of motulator."
      MaskDisplay   "Icon:text(0, -15, 'Sensorless')\n"
"Icon:text(0, 0, 'flux-vector')\n"
"Icon:text(0, 15, 'control')"
      MaskDisplayLang "2"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "n_p"
        Prompt        "n_p: Number of pole pairs"
        Type          FreeText
        Value         "3.0"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "R_s"
        Prompt        base64 "Ul9zOiBTdGF0b3IgcmVzaXN0YW5jZSAozqkp"
        Type          FreeText
        Value         "3.6*.8"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "L_d"
        Prompt        "L_d: d-axis inductance (H)"
        Type          FreeText
        Value         "0.036"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "L_q"
        Prompt        "L_q: q-axis inductance (H)"
        Type          FreeText
        Value         "0.051"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "psi_f"
        Prompt        "psi_f: PM-flux linkage (Vs)"
        Type          FreeText
        Value         "0.545"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "i_s_max"
        Prompt        "i_s_max: Maximum stator current (A)"
        Type          FreeText
        Value         "6.5"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_tau"
        Prompt        "alpha_tau: Torque-control bandwidth (rad/s)"
        Type          FreeText
        Value         "2*pi*100"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_psi"
        Prompt        "alpha_psi: Flux-control bandwidth (rad/s), [] = alpha_t"
"au"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_i"
        Prompt        "alpha_i: Integral-action bandwidth (rad/s), [] = alpha_"
"tau"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_o"
        Prompt        "alpha_o: Speed estimation pole (rad/s), [] = default"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m)"
", [] = default"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "psi_s_min"
        Prompt        "psi_s_min: Minimum stator flux (Vs), [] = psi_f"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "psi_s_max"
        Prompt        "psi_s_max: Maximum stator flux (Vs)"
        Type          FreeText
        Value         "inf"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_u"
        Prompt        "k_u: Voltage utilization factor"
        Type          FreeText
        Value         "0.9"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_mtpv"
        Prompt        "k_mtpv: MTPV margin"
        Type          FreeText
        Value         "0.85"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "J"
        Prompt        base64 "SjogSW5lcnRpYSAoa2dtwrIpIGZvciB0aGUgc3BlZWQgb2Jz"
"ZXJ2ZXIsIFtdID0gbm90IHVzZWQ="
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "0.000125"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
